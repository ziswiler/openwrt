#include "rtl931x.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "xikestor,sks7300-8f4x", "realtek,rtl9313-soc";
	model = "XikeStor SKS7300-8F4X";

	aliases {
		label-mac-device = &ethernet0;
		led-boot = &led_sys;
		led-failsafe = &led_sys;
		led-running = &led_sys;
		led-upgrade = &led_sys;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/* Silencing the kernel is required since otherwise the watchdog
		   would time out! */
		bootargs = "quiet";
	};

	keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_sys: led-0 {
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
		};
	};

	led_set {
		compatible = "realtek,rtl9300-leds";
		active-low;

		/* LED[0]: green | LED[1]: amber */
		led_set0 = <(RTL93XX_LED_SET_10G | RTL93XX_LED_SET_LINK |
			     RTL93XX_LED_SET_ACT)
			    (RTL93XX_LED_SET_2P5G | RTL93XX_LED_SET_1G |
			     RTL93XX_LED_SET_LINK | RTL93XX_LED_SET_ACT)>;
	};

	i2c-gpio0 {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;

		scl-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		sda-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;

		i2c-gpio,delay-us = <5>;	/* ~100 kHz */
		lm75: sensor@4f {
			compatible = "national,lm75a";
			reg = <0x4f>;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>, /* first 256 MiB */
		      <0x90000000 0x10000000>; /* remaining 256 MiB */
	};

	watchdog {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
		hw_algo = "toggle";
		hw_margin_ms = <1200>;
		always-running;
	};
};

&ethernet0 {
	nvmem-cells = <&macaddr_ubootenv_ethaddr 0>;
	nvmem-cell-names = "mac-address";
};

&i2c_mst1 {
	status = "okay";

	i2c1_sda0: i2c@0 {
		reg = <0>;
	};
	i2c1_sda1: i2c@1 {
		reg = <1>;
	};
	i2c1_sda2: i2c@2 {
		reg = <2>;
	};
	i2c1_sda3: i2c@3 {
		reg = <3>;
	};
	i2c1_sda4: i2c@4 {
		reg = <4>;
	};
	i2c1_sda5: i2c@5 {
		reg = <5>;
	};
};

&i2c_mst2 {
	status = "okay";

	i2c2_sda6: i2c@6 {
		reg = <6>;
	};
	i2c2_sda7: i2c@7 {
		reg = <7>;
	};
	i2c2_sda8: i2c@8 {
		reg = <8>;
	};
	i2c2_sda9: i2c@9 {
		reg = <9>;
	};
	i2c2_sda10: i2c@a {
		reg = <10>;
	};
	i2c2_sda11: i2c@b {
		reg = <11>;
	};
};

&serdes2 {
	realtek,pnswap-tx;
};

&serdes3 {
	realtek,pnswap-tx;
};

&serdes4 {
	realtek,pnswap-tx;
};

&serdes5 {
	realtek,pnswap-tx;
};

&serdes6 {
	realtek,pnswap-tx;
};

&serdes7 {
	realtek,pnswap-tx;
};

&serdes8 {
	realtek,pnswap-tx;
};

&serdes9 {
	realtek,pnswap-tx;
};

&serdes10 {
	realtek,pnswap-tx;
};

&serdes11 {
	realtek,pnswap-tx;
};

&serdes12 {
	realtek,pnswap-tx;
};

&serdes13 {
	realtek,pnswap-tx;
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x0a0000>;
				read-only;
			};

			partition@0a0000 {
				label = "u-boot-env";
				reg = <0x0a0000 0x10000>;

				nvmem-layout {
					compatible = "u-boot,env";

					macaddr_ubootenv_ethaddr: ethaddr {
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@b0000 {
				label = "reserve";
				reg = <0xb0000 0x80000>;
				read-only;
			};

			partition@130000 {
				label = "config";
				reg = <0x130000 0x350000>;
				read-only;
			};

			partition@480000 {
				label = "firmware";
				reg = <0x480000 0x01b80000>;

				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				partition@0 {
					label = "kernel";
					reg = <0x0 0x800000>;
				};

				partition@800000 {
					label = "rootfs";
					reg = <0x800000 0x1380000>;
				};
			};
		};
	};
};

&switch0 {
	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port0: port@0 {
			reg = <0>;
			label = "lan1";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes2>;
			phy-mode = "1000base-x";
		};

		port8: port@8 {
			reg = <8>;
			label = "lan2";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes3>;
			phy-mode = "1000base-x";
		};

		port16: port@16 {
			reg = <16>;
			label = "lan3";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes4>;
			phy-mode = "1000base-x";
		};

		port24: port@24 {
			reg = <24>;
			label = "lan4";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes5>;
			phy-mode = "1000base-x";
		};

		port32: port@32 {
			reg = <32>;
			label = "lan5";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes6>;
			phy-mode = "1000base-x";
		};

		port40: port@40 {
			reg = <40>;
			label = "lan6";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes7>;
			phy-mode = "1000base-x";
		};

		port48: port@48 {
			reg = <48>;
			label = "lan7";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes8>;
			phy-mode = "1000base-x";
		};

		port50: port@50 {
			reg = <50>;
			label = "lan8";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes9>;
			phy-mode = "1000base-x";
		};

		port52: port@52 {
			reg = <52>;
			label = "lan10";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes10>;
			phy-mode = "1000base-x";
		};

		port53: port@53 {
			reg = <53>;
			label = "lan9";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes11>;
			phy-mode = "1000base-x";
		};

		port54: port@54 {
			reg = <54>;
			label = "lan12";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes12>;
			phy-mode = "1000base-x";
		};

		port55: port@55 {
			reg = <55>;
			label = "lan11";
			led-set = <0>;
			managed = "in-band-status";
			pcs-handle = <&serdes13>;
			phy-mode = "1000base-x";
		};

		/* CPU port */
		port@56 {
			ethernet = <&ethernet0>;
			reg = <56>;
			phy-mode = "internal";
			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};
	};
};
